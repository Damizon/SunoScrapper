<Window x:Class="SunoScrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suno Library" Icon="scrapper.ico" Width="1440" Height="900" MinWidth="720" MinHeight="464" FontSize="12"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101419" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="0" Background="#0B0D10" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="scrapper.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Suno Library" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RootPathText" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RescanButton" Content="Rescan library" Style="{StaticResource AccentButton}" Click="Rescan_Click"/>
                    <Button x:Name="FullscreenButton" Content="Full screen  F11" Click="Fullscreen_Click"
                            Background="#172F52" BorderBrush="#315F91" Foreground="#D9EBFF"/>
                    <Button Content="Expand all" Click="ExpandAll_Click" Background="#244A35" BorderBrush="#4C9A69" Foreground="#D9FFE5"/>
                    <Button Content="Collapse all" Click="CollapseAll_Click" Background="#4B3020" BorderBrush="#C27A3B" Foreground="#FFE2C7"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" FontSize="12" TextChanged="SearchBox_TextChanged"
                         ToolTip="Search titles, artists, prompts, lyrics, tags, voices and workflows"/>
                <ComboBox x:Name="SortBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="SortBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Workflow order"/>
                    <ComboBoxItem Content="Newest first"/>
                    <ComboBoxItem Content="Oldest first"/>
                    <ComboBoxItem Content="Title A–Z"/>
                    <ComboBoxItem Content="Longest first"/>
                </ComboBox>
                <TextBlock x:Name="StatsText" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                <ItemsControl x:Name="WorkflowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,7">
                                <Expander.Header>
                                    <Border Background="{Binding HeaderBackground}" BorderBrush="{Binding HeaderBorderBrush}" BorderThickness="1" CornerRadius="0" Padding="9,6" Margin="0,0,0,4">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding CountText}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding HeaderForeground}" FontSize="13" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </Border>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Songs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="0" Padding="8" Margin="11,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="64" Background="#0E1115" CornerRadius="0" VerticalAlignment="Top" HorizontalAlignment="Left" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="NO ART" Foreground="#66717C" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondary}" Margin="7,1,0,0" FontSize="11"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock Text="  ·  " Foreground="#63707C"/>
                                                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock Text="  ·  " Foreground="#63707C"/>
                                                            <TextBlock Text="{Binding ModelText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  ·  " Foreground="#63707C"/>
                                                            <TextBlock Text="{Binding GenerationType}" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock Text="  " />
                                                            <TextBlock Text="♥" Foreground="#EC5D78" FontSize="15">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLiked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TagsText}" Foreground="#BBC6D0" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding PersonaText}" Foreground="#D4A7FF" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DuplicateText}" Foreground="#F0B45A" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding DuplicateLocationText}" Foreground="#A9B9CA" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap" ToolTip="{Binding DuplicateLocationText}"
                                                                   Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding SliderText}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>

                                                        <WrapPanel Margin="0,7,0,0">
                                                            <Button Content="Open MP3" Tag="{Binding}" Click="OpenMp3_Click" IsEnabled="{Binding HasMp3}"/>
                                                            <Button Content="Download MP3" Tag="{Binding}" Click="DownloadMp3_Click" IsEnabled="{Binding CanDownloadMp3}"/>
                                                            <Button Content="Open WAV" Tag="{Binding}" Click="OpenWav_Click" IsEnabled="{Binding HasWav}"/>
                                                            <Button Content="Show WAV in Explorer" Tag="{Binding}" Click="RevealWav_Click" IsEnabled="{Binding HasWav}"/>
                                                            <Button Content="Copy WAV" Tag="{Binding}" Click="CopyWav_Click" IsEnabled="{Binding HasWav}"/>
                                                            <Button Content="Copy path" Tag="{Binding}" Click="CopyPath_Click" IsEnabled="{Binding HasWav}"/>
                                                            <Button Content="Delete duplicate" Tag="{Binding}" Click="DeleteDuplicate_Click"
                                                                    Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}"
                                                                    Background="#58231F" BorderBrush="#D65A50" Foreground="#FFD8D4"/>
                                                        </WrapPanel>

                                                        <StackPanel>
                                                            <WrapPanel>
                                                                <ToggleButton Content="Prompt" Style="{StaticResource PanelToggle}" IsChecked="{Binding IsPromptOpen, Mode=TwoWay}" IsEnabled="{Binding HasPrompt}"/>
                                                                <ToggleButton Content="Lyrics" Style="{StaticResource PanelToggle}" IsChecked="{Binding IsLyricsOpen, Mode=TwoWay}" IsEnabled="{Binding HasLyrics}"/>
                                                                <ToggleButton Content="Generation details" Style="{StaticResource PanelToggle}" IsChecked="{Binding IsGenerationDetailsOpen, Mode=TwoWay}"/>
                                                            </WrapPanel>
                                                            <UniformGrid Columns="{Binding OpenPanelCount}" Visibility="{Binding HasOpenPanels, Converter={StaticResource BoolToVisibility}}">
                                                                <Border Background="#101419" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,2,5,0" Visibility="{Binding IsPromptOpen, Converter={StaticResource BoolToVisibility}}">
                                                                    <StackPanel>
                                                                        <Button Content="Copy prompt" HorizontalAlignment="Left" Margin="0,0,0,7" Tag="{Binding}" Click="CopyPrompt_Click"/>
                                                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                            <TextBlock Text="{Binding StylePrompt}" TextWrapping="Wrap" Foreground="#D5DCE3"/>
                                                                        </ScrollViewer>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="#101419" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,2,5,0" Visibility="{Binding IsLyricsOpen, Converter={StaticResource BoolToVisibility}}">
                                                                    <StackPanel>
                                                                        <Button Content="Copy lyrics" HorizontalAlignment="Left" Margin="0,0,0,7" Tag="{Binding}" Click="CopyLyrics_Click"/>
                                                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                            <TextBlock Text="{Binding Lyrics}" TextWrapping="Wrap" Foreground="#D5DCE3"/>
                                                                        </ScrollViewer>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="#101419" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,2,0,0" Visibility="{Binding IsGenerationDetailsOpen, Converter={StaticResource BoolToVisibility}}">
                                                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                                                            </Grid.RowDefinitions>
                                                                            <TextBlock Text="Created" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Column="1" Text="{Binding DateText}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="1" Text="Model" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelName}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="2" Text="Type" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GenerationType}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="3" Text="Persona" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PersonaName}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="4" Text="Style / sliders" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SliderText}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="5" Text="Source clip ID" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SourceClipId}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="6" Text="Suno ID" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Id}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="7" Text="Metadata file" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,3"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MetadataPath}" TextWrapping="Wrap" ToolTip="{Binding MetadataPath}"/>
                                                                            <TextBlock Grid.Row="8" Text="Local WAV" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding WavPath}" TextWrapping="Wrap" ToolTip="{Binding WavPath}"/>
                                                                        </Grid>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyState" Background="{StaticResource WindowBg}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No songs found" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Place SunoScrapper.exe in the folder that contains your Suno workflow folders, then rescan." Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#101419" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="120" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>





